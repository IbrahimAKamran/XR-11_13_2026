# Copy to .env (git-ignored) only if you need to override run.sh's defaults.
# run.sh sources this file, so values here win over your shell environment.
# Build-time: baked into the phone bundle by build.ts. run.sh sets it from the
# Mac's LAN IP automatically; set it here for a fixed address (e.g. a tunnel).
# MENTRA_PUBLIC_INGEST_URL=http://192.168.1.23:3100
# Mac-side ingest server port (default 3100). Must match the URL above.
# INGEST_PORT=3100
# Where recordings are written (default ./recordings).
# INGEST_DIR=./recordings
