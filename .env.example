# Copy to .env (git-ignored). run.sh reads this file (KEY=value, spaces and quotes are fine); values here
# win over your shell environment. Changes take effect on the next ./run.sh start.

# --- Mac-side transcription with speaker labels (server/ingest.ts) ---
# Deepgram API key: https://console.deepgram.com  (leave unset to run without transcription)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en            # or "multi" for code-switching
# DEEPGRAM_EXTRA_PARAMS=          # extra query params, e.g. keyterm=Mentra (diarize_model=latest is already sent)
# TRANSCRIBE=deepgram             # or "off" to only record

# --- Uplink / storage ---
# Build-time: baked into the phone bundle by build.ts. run.sh sets it from the Mac's LAN IP.
# MENTRA_PUBLIC_INGEST_URL=http://192.168.1.23:3100
# INGEST_PORT=3100
# INGEST_DIR=./recordings
# FIELDASSIST_DB=./data/fieldassist.sqlite
# MENTRA_PUBLIC_CONTINUOUS_AUDIO=1   # build-time: ask the glasses to disable VAD + loudness gating (far-field speech)
